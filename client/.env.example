# Base URL the frontend calls for the API.
#
# Local dev: leave unset. Vite's dev server proxies "/api" to the backend
# (see vite.config.ts), so the default value of "/api" works out of the box.
#
# Production (e.g. deployed on Vercel with the backend on Render/elsewhere):
# set this to your deployed backend's full URL, including the "/api" suffix.
# Example: VITE_API_URL=https://ai-qa-detective-api.onrender.com/api
VITE_API_URL=
