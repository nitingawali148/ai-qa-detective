# Base URL the frontend calls for the API.
#
# Leave unset for the default single-deployment setup (Vite dev server proxy
# locally via vite.config.ts, or the unified Vercel deployment in production
# — see /vercel.json at the repo root). In both cases the frontend and API
# share the same origin, so the default value of "/api" works out of the box.
#
# Only set this if you deploy the backend as a SEPARATE service on a
# different domain (see DEPLOYMENT.md's "Split deployment" section), e.g.:
# VITE_API_URL=https://ai-qa-detective-api.onrender.com/api
VITE_API_URL=
