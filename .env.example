# ── AI Provider Configuration ─────────────────────────────────────────────
# Choose which LLM provider powers AI QA Detective.
# Supported values: "anthropic" | "openai" | "mock"
# "mock" requires no API key and lets the app run fully offline for demos.
AI_PROVIDER=mock

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── Server ─────────────────────────────────────────────────────────────────
PORT=4000

# Comma-separated list of allowed origins for CORS in production (e.g. your
# deployed Vercel URL: https://ai-qa-detective.vercel.app). Leave unset to
# allow all origins (fine for local dev / quick deploys).
CORS_ORIGIN=

# ── Jira Integration (optional) ────────────────────────────────────────────
# When these are not set, the app uses a realistic MOCK Jira flow and clearly
# labels created defects as simulated, never claiming a real ticket was made.
JIRA_URL=
JIRA_PROJECT_KEY=
JIRA_EMAIL=
JIRA_API_TOKEN=
